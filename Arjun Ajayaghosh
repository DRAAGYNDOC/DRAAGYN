import React, { useState, useEffect } from 'react';
import { initializeApp } from "firebase/app";
import { getFirestore, collection, addDoc, onSnapshot, query, orderBy, Timestamp } from "firebase/firestore";

// --- PASTE YOUR FIREBASE CONFIG HERE ---
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_PROJECT.firebaseapp.com",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_PROJECT.appspot.com",
  messagingSenderId: "YOUR_ID",
  appId: "YOUR_APP_ID"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

export default function FamilyApp() {
  const [events, setEvents] = useState([]);
  const [form, setForm] = useState({ title: '', date: '', type: 'Duty', person: '' });
  const [view, setView] = useState('dashboard'); // 'dashboard' or 'add'

  // 1. REAL-TIME SYNC: Listen to changes in the family database
  useEffect(() => {
    const q = query(collection(db, "familyEvents"), orderBy("date", "asc"));
    const unsubscribe = onSnapshot(q, (snapshot) => {
      const eventList = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setEvents(eventList);
      checkReminders(eventList);
    });
    return () => unsubscribe();
  }, []);

  // 2. REMINDER ALARM LOGIC
  const checkReminders = (list) => {
    const today = new Date().toISOString().split('T')[0];
    list.forEach(event => {
      if (event.date === today) {
        // Basic browser alert for reminder
        if ("Notification" in window && Notification.permission === "granted") {
          new Notification(`TODAY: ${event.person}'s ${event.title}`);
        }
      }
    });
  };

  const requestNotificationPermission = () => {
    Notification.requestPermission();
  };

  // 3. ADD EVENT TO SHARED DATABASE
  const saveEvent = async (e) => {
    e.preventDefault();
    if (!form.title || !form.date) return alert("Fill in details");
    
    await addDoc(collection(db, "familyEvents"), {
      ...form,
      createdAt: Timestamp.now()
    });
    setForm({ title: '', date: '', type: 'Duty', person: '' });
    setView('dashboard');
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans pb-20">
      {/* Header */}
      <header className="bg-indigo-600 text-white p-6 shadow-lg">
        <h1 className="text-2xl font-bold">Family Command Center</h1>
        <p className="text-indigo-100 text-sm">Everyone is on the same page.</p>
      </header>

      {/* Navigation Tabs */}
      <div className="flex bg-white border-b">
        <button 
          onClick={() => setView('dashboard')}
          className={`flex-1 p-4 text-center font-medium ${view === 'dashboard' ? 'border-b-4 border-indigo-600 text-indigo-600' : 'text-gray-500'}`}
        >
          📅 Dashboard
        </button>
        <button 
          onClick={() => setView('add')}
          className={`flex-1 p-4 text-center font-medium ${view === 'add' ? 'border-b-4 border-indigo-600 text-indigo-600' : 'text-gray-500'}`}
        >
          ➕ Add New
        </button>
      </div>

      <main className="p-4 max-w-md mx-auto">
        {view === 'dashboard' ? (
          <div className="space-y-4">
            <button 
              onClick={requestNotificationPermission}
              className="text-xs bg-gray-200 px-2 py-1 rounded mb-4"
            >
              🔔 Enable Alarms
            </button>

            <h2 className="font-bold text-gray-700 uppercase text-xs tracking-wider">Upcoming Events</h2>
            
            {events.length === 0 && <p className="text-gray-400 text-center py-10">No plans yet. Add one!</p>}

            {events.map(event => (
              <div key={event.id} className="bg-white p-4 rounded-xl shadow-sm border-l-8 border-indigo-500 flex justify-between items-center">
                <div>
                  <span className={`text-[10px] px-2 py-0.5 rounded-full uppercase font-bold ${
                    event.type === 'Birthday' ? 'bg-pink-100 text-pink-600' : 'bg-blue-100 text-blue-600'
                  }`}>
                    {event.type}
                  </span>
                  <h3 className="text-lg font-bold text-gray-800 leading-tight">{event.title}</h3>
                  <p className="text-gray-500 text-sm">{event.date} • <span className="font-medium text-indigo-600">{event.person}</span></p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <form onSubmit={saveEvent} className="bg-white p-6 rounded-2xl shadow-md space-y-4">
            <h2 className="text-xl font-bold">Add Event/Duty</h2>
            
            <div>
              <label className="block text-sm font-medium text-gray-700">What is it?</label>
              <input 
                type="text" 
                placeholder="e.g. Kitchen Cleaning"
                className="w-full p-3 mt-1 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"
                value={form.title}
                onChange={e => setForm({...form, title: e.target.value})}
              />
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700">Category</label>
                <select 
                  className="w-full p-3 mt-1 border rounded-lg bg-white"
                  value={form.type}
                  onChange={e => setForm({...form, type: e.target.value})}
                >
                  <option>Duty</option>
                  <option>Birthday</option>
                  <option>Important</option>
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700">Who?</label>
                <input 
                  type="text" 
                  placeholder="Name"
                  className="w-full p-3 mt-1 border rounded-lg outline-none"
                  value={form.person}
                  onChange={e => setForm({...form, person: e.target.value})}
                />
              </div>
            </div>

            <div>
              <label className="block text-sm font-medium text-gray-700">Date</label>
              <input 
                type="date" 
                className="w-full p-3 mt-1 border rounded-lg outline-none"
                value={form.date}
                onChange={e => setForm({...form, date: e.target.value})}
              />
            </div>

            <button type="submit" className="w-full bg-indigo-600 text-white p-4 rounded-lg font-bold shadow-lg active:scale-95 transition-transform">
              Share with Family
            </button>
          </form>
        )}
      </main>
    </div>
  );
}
